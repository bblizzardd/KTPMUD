digraph DFD1 {
  rankdir=LR; nodesep=0.35; ranksep=1.1; splines=true; newrank=true;
  fontname="DejaVu Sans"; label="Biểu đồ luồng dữ liệu mức 1 (mức đỉnh)"; labelloc=t; fontsize=16;
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8, color="#444444"];
  node [shape=box, style=filled, fillcolor="#FFF4DB"];
