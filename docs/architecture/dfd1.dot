  TM  [label="Đồng hồ hệ thống", fillcolor="#F2F2F2"];
  node [shape=circle, fillcolor="#D9E2F3", color="#2E5395", width=1.35, fixedsize=true];
  P1 [label="1\nQuản lý hồ sơ\nvà ủy quyền"];
  P2 [label="2\nQuản lý\nđơn thuốc"];
  P3 [label="3\nTheo dõi\ntuân thủ"];
  P4 [label="4\nChỉ số và\ntái khám"];
  P5 [label="5\nBáo cáo\nvà ghi vết"];
  node [shape=record, fillcolor="#FBE5D6", color="#7F6000", width=0, fixedsize=false];
  D1 [label="{D1 | Hồ sơ, ủy quyền}"];
  D2 [label="{D2 | Đơn thuốc}"];
  D3 [label="{D3 | Danh mục thuốc}"];
  D4 [label="{D4 | Cữ thuốc, xác nhận}"];
  D5 [label="{D5 | Chỉ số, lịch hẹn}"];
  D6 [label="{D6 | Nhật ký thao tác}"];

  CG -> P1 [label="hồ sơ, ủy quyền,\nmã ghép nối"];
  P1 -> D1;
  CG -> P2 [label="thông tin đơn thuốc"];
  DM -> P2 [label="danh mục chuẩn"];
  P2 -> D3 [label="nạp danh mục"];
  D3 -> P2 [label="gợi ý tên thuốc"];
