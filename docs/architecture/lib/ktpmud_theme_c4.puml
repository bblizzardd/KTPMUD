<style>
root {
  FontName DejaVu Sans
}
title {
  FontName DejaVu Sans
  FontSize 16
  FontStyle bold
  FontColor #2E5395
}
</style>
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
