@startuml
skinparam defaultFontName Arial
skinparam linetype ortho
title ERD — PostgreSQL mục tiêu (chưa thay thế SQLite local)
entity alerts {
 id: uuid
 patient_id: uuid
 event_key: text
 type: text
 message: text
 created_at: timestamp with time zone
 read_at: timestamp with time zone
}
entity appointments {
 id: uuid
 patient_id: uuid
 appointment_on: date
 remind_days: integer
 note: text
}
entity audit_logs {
 id: uuid
 occurred_at: timestamp with time zone
 actor_id: text
 actor_role: text
 action_type: text
 status: text
 object_id: text
 detail: text
}
entity caregivers {
 id: uuid
 email: text
 display_name: character varying
 password_hash: text
 created_at: timestamp with time zone
}
entity delegates {
 id: uuid
 patient_id: uuid
 nickname: character varying
 relationship: text
 active: boolean
}
entity devices {
 id: uuid
 patient_id: uuid
 delegate_id: uuid
 role: text
 token_hash: text
 active: boolean
 platform: text
 push_token_ciphertext: bytea
}
entity dose_confirmations {
 id: uuid
 dose_id: uuid
 actor_device_id: uuid
 actor_role: text
 took_at: timestamp with time zone
 recorded_at: timestamp with time zone
 status: text
 corrects_id: uuid
 reason: text
}
entity doses {
 id: uuid
 prescription_id: uuid
 slot: text
 scheduled_at: timestamp with time zone
 deadline: timestamp with time zone
 status: text
}
entity drug_ingredients {
 drug_id: uuid
 ingredient_id: uuid
 strength: text
}
entity drugs {
 id: uuid
 name: text
 registration_number: text
 dosage_form: text
}
entity ingredients {
 id: uuid
 name: text
}
entity lab_results {
 id: uuid
 patient_id: uuid
 type_code: text
 value: numeric
 measured_on: date
}
entity lab_types {
 code: text
 label: text
 unit: text
}
entity pairing_codes {
 code_hash: text
 patient_id: uuid
 role: text
 expires_at: timestamp with time zone
 used_at: timestamp with time zone
}
entity patient_slots {
 patient_id: uuid
 slot: text
 reminder_time: time without time zone
}
entity patients {
 id: uuid
 caregiver_id: uuid
 nickname: character varying
 birth_year: smallint
 missed_threshold_minutes: integer
 created_at: timestamp with time zone
}
entity prescription_item_slots {
 item_id: uuid
 slot: text
}
entity prescription_items {
 id: uuid
 prescription_id: uuid
 original_name: text
 drug_id: uuid
 quantity: numeric
 unit: text
 note: text
}
entity prescriptions {
 id: uuid
 patient_id: uuid
 issued_on: date
 starts_on: date
 ends_on: date
 status: text
 confirmed_at: timestamp with time zone
}
entity reports {
 id: uuid
 patient_id: uuid
 requested_by: uuid
 period_start: date
 period_end: date
 status: text
 file_key: text
 created_at: timestamp with time zone
}
caregivers ||--o{ patients
patients ||--o{ patient_slots
patients ||--o{ delegates
patients ||--o{ devices
delegates ||--o{ devices
patients ||--o{ pairing_codes
drugs ||--o{ drug_ingredients
ingredients ||--o{ drug_ingredients
patients ||--o{ prescriptions
prescriptions ||--o{ prescription_items
drugs ||--o{ prescription_items
prescription_items ||--o{ prescription_item_slots
prescriptions ||--o{ doses
doses ||--o{ dose_confirmations
devices ||--o{ dose_confirmations
dose_confirmations ||--o{ dose_confirmations
patients ||--o{ alerts
patients ||--o{ lab_results
lab_types ||--o{ lab_results
patients ||--o{ appointments
patients ||--o{ reports
caregivers ||--o{ reports
@enduml
