@startuml
!pragma layout smetana
skinparam defaultFontName Arial
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #34596B
skinparam titleFontSize 20
title Luồng màn hình bản local
start
:Trang đăng nhập / ghép thiết bị;
if (Vai trò người chăm sóc?) then (Có)
 :Chọn hoặc tạo hồ sơ;
 :Tổng quan;
 fork
  :Đơn thuốc → nhập nháp → xác nhận;
 fork again
  :Gia đình & thiết bị → ghép / thu hồi;
 fork again
  :Chỉ số / lịch tái khám;
 fork again
  :Báo cáo → tải PDF;
 end fork
else (Thiết bị)
 :Nhập mã ghép nếu chưa có phiên;
 :Xem cữ và nhắc;
 :Xác nhận / xác nhận hộ;
 :Xem thời điểm đã ghi nhận;
endif
stop
@enduml
