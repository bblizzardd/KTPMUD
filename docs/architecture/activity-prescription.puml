@startuml
!pragma layout smetana
skinparam defaultFontName Arial
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #34596B
skinparam titleFontSize 20
title Hoạt động — xác nhận và thay đơn
start
:Người chăm sóc nhập / đối chiếu đơn;
if (Dữ liệu hợp lệ và có quyền?) then (Có)
 :Lưu đơn nháp;
 :Người chăm sóc xác nhận;
 :Bắt đầu giao dịch;
 :Kiểm tra đơn còn nháp;
 :Thay thế đơn cũ, hủy cữ tương lai;
 :Kích hoạt đơn mới;
 :Sinh lịch hoặc ghi sự kiện worker;
 if (Giao dịch thành công?) then (Có)
  :Commit và ghi kết quả;
 else (Không)
  :Rollback; báo lỗi;
 endif
else (Không)
 :Báo lỗi, không đổi dữ liệu;
endif
stop
@enduml
