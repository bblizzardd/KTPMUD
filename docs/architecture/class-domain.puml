@startuml
!pragma layout smetana
skinparam defaultFontName Arial
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #34596B
skinparam titleFontSize 20
title UML Class — Mô hình nghiệp vụ mục tiêu
class Caregiver {
 +id: UUID
 +email: String
 +createPatient(): Patient
}
class Patient {
 +id: UUID
 +nickname: String
 +birthYear: Integer
 +thresholdMinutes: Integer
}
class Device {
 +id: UUID
 +role: Role
 +active: Boolean
 +revoke(): void
}
class Prescription {
 +id: UUID
 +issuedOn: Date
 +startsOn: Date
 +endsOn: Date
 +status: RxStatus
 +confirm(): void
 +replace(): void
}
class PrescriptionItem {
 +originalName: String
 +quantity: Decimal
 +slots: Set<Slot>
}
class Dose {
 +id: UUID
 +scheduledAt: DateTime
 +deadline: DateTime
 +status: DoseStatus
 +confirm(): Confirmation
}
class Confirmation {
 +id: UUID
 +actorRole: Role
 +tookAt: DateTime
 +recordedAt: DateTime
 +correctsId: UUID
 +correct(reason): Confirmation
}
class RuleEngine {
 +evaluate(dose, time): Status
 +findDuplicateIngredients(rx): Warning[]
}
Caregiver "1" -- "0..*" Patient : quản lý
Patient "1" -- "0..*" Device
Patient "1" -- "0..*" Prescription
Prescription "1" *-- "1..*" PrescriptionItem
Prescription "1" -- "0..*" Dose
Dose "1" -- "0..*" Confirmation
Device "1" -- "0..*" Confirmation : thực hiện
RuleEngine ..> Dose
RuleEngine ..> Prescription
note bottom of Confirmation
Chỉ thêm; không sửa/xóa. Đây là lớp thiết kế,
không phải tuyên bố mã local dùng OOP.
end note
@enduml
