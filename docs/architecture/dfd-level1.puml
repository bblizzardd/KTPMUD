@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #34596B
skinparam titleFontSize 20
title DFD mức 1 — Dòng dữ liệu nghiệp vụ
top to bottom direction
rectangle "Người chăm sóc" as c
rectangle "Bệnh nhân / người nhà" as p
circle "1. Hồ sơ & quyền" as p1
circle "2. Quản lý đơn" as p2
circle "3. Lập lịch & nhắc" as p3
circle "4. Ghi nhận" as p4
circle "5. Tổng hợp / PDF" as p5
database "D1 Hồ sơ & thiết bị" as d1
database "D2 Đơn & dòng thuốc" as d2
database "D3 Cữ & cảnh báo" as d3
database "D4 Xác nhận" as d4
database "D5 Chỉ số & lịch hẹn" as d5
database "D6 Nhật ký" as d6
c --> p1 : Thông tin hồ sơ, ủy quyền
p --> p1 : Mã ghép
p1 --> d1 : Hồ sơ, quyền
p1 --> c : Kết quả quản lý
p1 --> p : Phiên thiết bị
c --> p2 : Đơn nhập và xác nhận
p2 --> d2 : Đơn nháp / hiệu lực
p2 --> c : Kết quả đối chiếu đơn
p2 --> p3 : Đơn đã xác nhận
d1 --> p3 : Giờ nhắc, người nhận
p3 --> d3 : Cữ và cảnh báo
p3 --> p : Nhắc cữ
p3 --> c : Cảnh báo bỏ lỡ
p --> p4 : Xác nhận / đính chính
d1 --> p4 : Quyền thiết bị
d3 --> p4 : Cữ hợp lệ
p4 --> d4 : Ghi nhận bất biến
p4 --> d3 : Trạng thái cữ
p4 --> p : Kết quả ghi nhận
c --> p5 : Chỉ số, lịch hẹn, yêu cầu báo cáo
p5 --> d5 : Chỉ số và lịch hẹn
d5 --> p3 : Mốc tái khám
d3 --> p5 : Lịch cữ
d4 --> p5 : Vai trò và thời điểm
d5 --> p5 : Chỉ số / lịch hẹn
p5 --> c : Tổng quan / PDF
p1 --> d6 : Sự kiện ghi
p2 --> d6 : Sự kiện ghi
p3 --> d6 : Sự kiện ghi
p4 --> d6 : Sự kiện ghi
p5 --> d6 : Sự kiện ghi
@enduml
