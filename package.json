{
  "name": "antam-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js --production",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "mock": "node gateway/mock.js",
    "verify:handoff": "node --test tests/handoff.test.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check": "npm run check:syntax && npm test && npm run build",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=server/domain.js --test-coverage-lines=80 --test tests/domain.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@electric-sql/pglite": "^0.5.10",
    "swagger-ui-dist": "^5.34.0",
    "vite": "^7.2.0",
    "yaml": "^2.9.1"
  }
}
