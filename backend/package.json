{
  "name": "antam-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "reset-demo": "node --env-file-if-exists=.env scripts/reset-demo.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0",
    "ws": "^8.18.0",
    "pdfkit": "^0.17.2"
  }
}
