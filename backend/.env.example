HOST=127.0.0.1
PORT=8080
BASE_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATA_DIR=./data
INCLUDE_LATE_IN_RATE=false
# Optional for local development: persistent random keys are created in data/local-keys.json.
# Required when NODE_ENV=production:
# JWT_SECRET=<at-least-32-random-characters>
# TOKEN_ENCRYPTION_KEY=<64-hex-characters>
# PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf
# DEMO_EMAIL=demo@antam.local
# DEMO_PASSWORD=<choose-a-demo-password-at-least-8-characters>
# Web app served on the same port (built from ../frontend by `npm run build` there).
# FRONTEND_DIST=../frontend/dist
# Local clock starts at 06:00 Vietnam time on each backend startup; skips are enabled by default.
# Set false to use real time locally. Production always uses real time.
# ENABLE_DEV_TOOLS=false
# Fixed three-role logins on a test deployment (default on locally, off in production).
# ENABLE_TEST_ACCOUNTS=true
